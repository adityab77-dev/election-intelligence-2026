# ---------------------------------------------------------------------------
# election-intelligence-2026 — example environment file
#
# Copy to `.env` and fill in real values. `.env` is gitignored.
# All variables use the EI_ prefix; nested settings use `__` as delimiter.
# ---------------------------------------------------------------------------

# development | testing | production
EI_ENVIRONMENT=development
EI_DEBUG=false

# --- Database (DuckDB) ---
# EI_DATABASE__PATH=data/processed/election_intelligence.duckdb
# EI_DATABASE__READ_ONLY=false
# EI_DATABASE__THREADS=4

# --- Logging ---
# EI_LOGGING__LEVEL=INFO
# EI_LOGGING__JSON_FORMAT=false
# EI_LOGGING__LOG_TO_FILE=true

# --- Claude API (required to use the LLM layer) ---
EI_CLAUDE__API_KEY=
# EI_CLAUDE__MODEL=claude-opus-4-8
# EI_CLAUDE__MAX_TOKENS=4096
